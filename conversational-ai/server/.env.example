# Copy to server/.env and fill in real values.
# Never expose these to the browser.

GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Analytics uses data/analytics.sqlite by default. This database is not gitignored.
# ANALYTICS_DB_PATH=data/analytics.sqlite
# Optional Tiger Data PostgreSQL analytics (overrides local SQLite).
# Example: postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=verify-full
# Keep this server-side and URL-encode special password characters.
DATABASE_URL=

# Optional overrides
# PORT=3001
# GEMINI_MODEL=gemini-2.5-flash
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
