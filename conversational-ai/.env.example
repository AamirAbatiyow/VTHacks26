# Copy to server/.env and fill in real values.
# Never expose these to the browser.

GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Analytics uses data/analytics.sqlite by default. This database is not gitignored.
# ANALYTICS_DB_PATH=data/analytics.sqlite
# Optional Tiger Data PostgreSQL analytics (overrides local SQLite).
# Copy the service connection URI from Tiger Cloud. Keep this server-side.
# Use sslmode=verify-full for verified TLS; URL-encode special password characters.
DATABASE_URL=

# Optional overrides
# PORT=3001
# GEMINI_MODEL=gemini-3.6-flash
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Free ElevenLabs plans cannot use Voice Library voices.
# Default voices that work on free tier:
#   pFZP5JQG7iQjIQuC4Bku (Lily)  EXAVITQu4vr4xnSDxMaL (Sarah)
#   JBFqnCBsd6RMkjVDRZzb (George) cgSgspJ2msm6clMCkdW9 (Jessica)
