{
  "name": "conversational-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test:analytics": "npm run test:analytics -w server",
    "test:progress": "TSX_TSCONFIG_PATH=client/tsconfig.json node --import tsx --test client/src/progress/*.test.ts",
    "test:shared": "node --import tsx --test shared/*.test.ts",
    "db:migrate": "npm run db:migrate -w server --",
    "analytics:report": "npm run analytics:report -w server",
    "deploy:fly": "fly deploy .."
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
